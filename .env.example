# Supabase project credentials (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_APP_NAME=Shefaa

# Firebase, for browser notifications (Firebase console → Project settings).
# All optional: leave them out and the dashboard runs without notifications.
# All public -- they ship in the bundle. The secret half lives in the Edge
# Function, never here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging → Web configuration → Web Push certificates → "Key pair"
VITE_FIREBASE_VAPID_KEY=
